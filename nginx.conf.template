server {
    listen 443 ssl;
    http2 on;
    root /usr/share/nginx/html;

    ssl_certificate     ${SSL_CERT};
    ssl_certificate_key ${SSL_KEY};

    # Client-side routes (/shop, /product/:id) must fall back to index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
